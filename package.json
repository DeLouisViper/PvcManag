{
  "name": "haic-pvc-material-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HAIC PVC pipe & installation material management (Piezometer, Standpipe, Permeability, Seismic)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run src/lib/engine",
    "test:db": "vitest run tests/db",
    "db:bundle": "node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "dejavu-fonts-ttf": "^2.37.3",
    "pg": "^8.23.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
